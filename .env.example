# 复制成 .env 使用（.env 已被 .gitignore 忽略，千万不要提交密钥）
# 不配置任何一项也能启动：可以浏览、复习 demo 卡、多用户与邀请码。
# 只有「上传 PDF → 生成卡片」需要模型 + 打开上传 worker。

# ── 上传出卡（默认关闭）────────────────────────────────
UPLOAD_WORKER_ENABLED=1        # 设 1 才会真正处理上传的 PDF；0 = 只排队不处理
UPLOAD_MONTHLY_PAGES=600       # 每月上传页数配额

# ── 模型接入（任选一种 OpenAI 兼容端点）──────────────────
#   official → 厂商官方 API（未设 LLM_BASE_URL 时取 DEEPSEEK_BASE_URL）
#   proxy    → 自建网关，默认 http://localhost:4000（LiteLLM / One-API 之类）
#   local    → 本机模型服务，默认 http://localhost:8080/v1
LLM_PROVIDER=official
LLM_BASE_URL=https://api.deepseek.com/v1   # 也可换成 https://api.openai.com/v1 、Ollama 等
LLM_MODEL=deepseek-chat
LLM_API_KEY=                               # 你自己的密钥（不配则无法出卡）

# official 预设（LLM_PROVIDER=official 且未设 LLM_BASE_URL 时使用）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ── 对外开放前必须修改（默认值只适合本机开发）────────────
APP_SECRET=               # 随机字符串
JWT_SECRET=               # 随机字符串；留空会退回 APP_SECRET，都没有则用开发默认值
JWT_TTL_HOURS=720
S2_OWNER_USERNAME=owner   # 首个账号（owner）的用户名

# ── 其他可选 ──────────────────────────────────────────
# DATABASE_PATH=          # 指定 sqlite 文件路径（默认在实例目录下）
# KB_EXPORTS_DIR=         # 演示卡 jsonl 所在目录（默认 ~/data-local/exports）
